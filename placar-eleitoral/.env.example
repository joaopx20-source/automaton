# Copie para .env e preencha. Só as redes com credencial são lidas automaticamente;
# as outras continuam aceitando importação manual de comentários pelo painel.

PORT=3000
ADMIN_TOKEN=troque-por-uma-senha-forte
SYNC_INTERVAL_SECONDS=30
# 1 = cada pessoa conta só 1 voto por postagem (quando a rede informa o autor)
ONE_VOTE_PER_USER=0

# Facebook (token de Página com pages_read_engagement)
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram (conta profissional ligada à Página; permissão instagram_manage_comments)
INSTAGRAM_TOKEN=
INSTAGRAM_BUSINESS_ID=

