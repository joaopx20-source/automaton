# Copie este arquivo para .env (na mesma pasta) e preencha.

# Mesma senha do painel /admin
ADMIN_SENHA=

# Endereço do site (de onde vem a configuração do Firebase)
SITE=https://placar-das-redes-d045b.web.app

# De quantos em quantos segundos ler as redes (mínimo 30)
INTERVALO_SEGUNDOS=60

# ---- Chaves das redes (preencha só as que tiver) ----

# YouTube (Data API v3, grátis: console.cloud.google.com)
YOUTUBE_API_KEY=
# Páginas de 100 comentários antigos por leitura (6 por minuto cabem na cota grátis diária)
YOUTUBE_PAGINAS_POR_SYNC=6

# Facebook (token da sua Página)
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram (conta profissional ligada à Página)
INSTAGRAM_TOKEN=
INSTAGRAM_BUSINESS_ID=

# X / Twitter (API paga)
X_BEARER_TOKEN=

# TikTok (Research API, só com acesso aprovado)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
