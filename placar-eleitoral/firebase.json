{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=300"
          }
        ]
      }
    ],
    "predeploy": [
      "mkdir -p \"$PROJECT_DIR/public/fb/lib/connectors\" && cp \"$PROJECT_DIR\"/lib/*.js \"$PROJECT_DIR/public/fb/lib/\" && cp \"$PROJECT_DIR\"/lib/connectors/*.js \"$PROJECT_DIR/public/fb/lib/connectors/\""
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      "test",
      ".env.example"
    ],
    "predeploy": [
      "rm -rf \"$RESOURCE_DIR/lib\" && cp -r \"$PROJECT_DIR/lib\" \"$RESOURCE_DIR/lib\""
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
