rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrador do placar (usuário criado no Firebase Authentication).
    function ehAdmin() {
      return request.auth != null && request.auth.uid == 'UID_DO_ADMIN';
    }

    // O placar público pode ser lido por qualquer pessoa; só o admin escreve.
    match /placar/resumo {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Postagens e comentários já contados: só o admin (painel) lê e escreve.
    match /postagens/{postagem} {
      allow read, write: if ehAdmin();
      match /vistos/{pedaco} {
        allow read, write: if ehAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
