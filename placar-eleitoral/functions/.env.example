# Copie para functions/.env e preencha. Este arquivo vai junto no deploy das funções
# (não é enviado ao GitHub). Sem chave, use a importação manual no painel.

ADMIN_TOKEN=troque-por-uma-senha-forte
# 1 = cada pessoa conta só 1 voto por postagem (quando a rede informa o autor)
ONE_VOTE_PER_USER=0

# Facebook (token de Página com pages_read_engagement e pages_read_user_content)
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram (conta profissional ligada à Página; instagram_manage_comments)
INSTAGRAM_TOKEN=
INSTAGRAM_BUSINESS_ID=

